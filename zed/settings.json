// settings.json, generated at Sat Mar 22 2025 17:00:58 GMT+0800 (Singapore Standard Time)
// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "cli_default_open_behavior": "existing_window",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
      "env": {
        "HTTP_PROXY": "http://127.0.0.1:19877",
        "HTTPS_PROXY": "http://127.0.0.1:19877",
        "ALL_PROXY": "http://127.0.0.1:19877",
        "http_proxy": "http://127.0.0.1:19877",
        "https_proxy": "http://127.0.0.1:19877",
        "all_proxy": "http://127.0.0.1:19877",
        "NO_PROXY": "localhost,127.0.0.1,::1",
        "no_proxy": "localhost,127.0.0.1,::1"
      }
    }
  },
  "agent": {
    "dock": "right",
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "gpt-5.1"
    },
    "model_parameters": []
  },
  "agent_ui_font_size": 25.0,
  "agent_buffer_font_size": 25.0,
  "base_keymap": "VSCode",
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark"
  },
  "ui_font_family": "ComicShannsMono Nerd Font Mono",
  "ui_font_size": 25.0,
  "buffer_font_size": 25.0,
  "buffer_font_family": "ComicShannsMono Nerd Font Mono",

  // Vim mode settings
  "vim_mode": true,
  // use relative line numbers
  "relative_line_numbers": "enabled",
  "tab_bar": {
    "show": true
  },
  "scrollbar": {
    "show": "never"
  },
  // Only show error on tab
  "tabs": {
    "show_diagnostics": "errors"
  },
  // Indentation, rainbow indentation
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware"
  },
  // NOTE: Zen mode, refer https://github.com/zed-industries/zed/issues/4382 when it's resolved
  "centered_layout": {
    "left_padding": 0.15,
    "right_padding": 0.15
  },
  // Keep Markdown previews wide enough for technical documentation and code blocks.
  "markdown_preview_font_size": 20.0,
  "markdown_preview": {
    "limit_content_width": true,
    "max_width": 1400
  },
  // Use Copilot Chat AI as default
  // Uncomment below to use local AI with Ollama, refer https://zed.dev/docs/language-model-integration?highlight=ollama#using-ollama-on-macos
  // "assistant": {
  //   "default_model": {
  //     "provider": "ollama",
  //     "model": "llama3.1:latest"
  //   },
  //   "version": "2",
  //   "provider": null
  // },
  // Inlay hints preconfigured by Zed: Go, Rust, Typescript and Svelte
  "inlay_hints": {
    "enabled": true
  },
  // Python: basedpyright provides semantic features; Ruff handles linting and formatting
  "lsp": {
    "basedpyright": {
      "settings": {
        // Ruff is the single source of truth for import organization
        "basedpyright.disableOrganizeImports": true,
        "basedpyright.analysis": {
          "diagnosticMode": "workspace",
          "typeCheckingMode": "standard",
          "autoImportCompletions": true,
          "autoSearchPaths": true,
          "useLibraryCodeForTypes": true,
          "autoFormatStrings": true,
          "inlayHints": {
            "variableTypes": true,
            "callArgumentNames": true,
            "callArgumentNamesMatching": false,
            "functionReturnTypes": true,
            "genericTypes": true
          }
        }
      }
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          // Prefer each project's pyproject.toml or ruff.toml when present
          "configurationPreference": "filesystemFirst",
          "fixAll": true,
          "organizeImports": true
        }
      }
    }
  },
  "languages": {
    "Python": {
      "language_servers": ["basedpyright", "ruff"],
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.ruff": true,
        "source.organizeImports.ruff": true
      },
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      }
    }
  },
  // Use zed commit editor
  "terminal": {
    "env": {
      "EDITOR": "zed --wait"
    }
  },
  // File syntax highlighting
  "file_types": {
    "Dockerfile": ["Dockerfile", "Dockerfile.*"],
    "JSON": ["json", "jsonc", "*.code-snippets"]
  },
  // File scan exclusions, hide on the file explorer and search
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    // above is default from Zed
    "**/out",
    "**/dist",
    "**/.husky",
    "**/.turbo",
    "**/.vscode-test",
    "**/.vscode",
    "**/.next",
    "**/.storybook",
    "**/.tap",
    "**/.nyc_output",
    "**/report",
    "**/node_modules"
  ],
  // Turn off telemetry
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "proxy": "http://127.0.0.1:19877",

  "edit_predictions": {
    // Add Markdown files to the disabled list
    // This merges with the default disabled globs (e.g., .env, secrets, etc.)
    "disabled_globs": ["**/*.md"]
  }
}
